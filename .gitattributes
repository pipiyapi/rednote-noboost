# 统一换行符：仓库内一律 LF，避免 Windows/macOS 协作者之间产生整文件 diff
* text=auto eol=lf

# 明确二进制，防止 Git 尝试做文本转换或行尾修复
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.wasm binary
*.traineddata binary

# lock 文件在 diff / 语言统计中折叠
package-lock.json -diff linguist-generated
pnpm-lock.yaml   -diff linguist-generated
